<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Olabode Chatbot</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
   
    <div class="chat-container">
        <div class="chat-header">
            <h4>Welcome to Olabode Chatbot</h4>
        </div>
        <div class="chat-messages" id="chat-messages">
            <div class="typing-indicator" id="typing-indicator">
                <span>.</span><span>.</span><span>.</span>
            </div>
        </div>
        <div class="chat-input">
            <input type="text" id="user-input" placeholder="Type your message here..." autocomplete="off">
            <button id="send-button">Send</button>
        </div>
        <div id="quick-questions" style="margin: 10px 0;">
            <label for="question-select"><b>Instant Questions:</b></label>
            <select id="question-select">
              <option value="">--Choose a topic--</option>
              <option value="portfolio">Show me your portfolio</option>
              <option value="projects">What projects have you done?</option>
              <option value="contact">How can I contact you?</option>
              <option value="help">I need help</option>
            </select>
          </div>
    </div>
 
      

    <!-- Before closing </body> tag -->
<script src="/js/chatbot.js"></script>
<script src="/js/response.js"></script>
</body>
</html>